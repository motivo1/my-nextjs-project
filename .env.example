OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=z-ai/glm-5.2

ODOO_URL=https://dev-erp.asunim.co
ODOO_DB=your-odoo-database-name
ODOO_USERNAME=your-odoo-username
# Use an Odoo API key (Settings > Account Security > API Keys) or a password.
ODOO_API_KEY=your-odoo-api-key

# --- Discuss AI bot (auto-starts with the app) ---
